{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode"
  },
  "plugins": [
    "opencode-overclock"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "terminal": {
    "title": true
  },
  "tabs": {
    "mode": "off"
  }
}
